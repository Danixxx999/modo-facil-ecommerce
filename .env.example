# PocketBase runtime
PB_ENCRYPTION_KEY=replace-with-a-long-random-secret
PB_PUBLIC_URL=http://127.0.0.1:8090

# Optional bootstrap accounts (recommended for first local setup)
PB_SUPERUSER_EMAIL=owner@example.com
PB_SUPERUSER_PASSWORD=replace-with-a-strong-password
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=replace-with-a-strong-password
PB_ADMIN_NAME=Store Admin
